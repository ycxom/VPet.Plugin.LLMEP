<UserControl x:Class="VPet.Plugin.LLMEP.ImageUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             HorizontalAlignment="Right"
             VerticalAlignment="Top"
             Margin="10">
    <!-- Telegram 风格的聊天气泡 -->
    <Border Background="White"
            CornerRadius="12"
            Padding="8"
            MaxWidth="200"
            MaxHeight="200">
        <Border.Effect>
            <DropShadowEffect Color="Black"
                            Opacity="0.2"
                            BlurRadius="10"
                            ShadowDepth="2"
                            Direction="270"/>
        </Border.Effect>

        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="复制图片" Click="CopyImage_Click" />
                <MenuItem Header="下载图片" Click="DownloadImage_Click" />
                <Separator />
                <MenuItem Header="关闭" Click="Close_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <Image x:Name="Image"
               Stretch="Uniform" />
    </Border>
</UserControl>