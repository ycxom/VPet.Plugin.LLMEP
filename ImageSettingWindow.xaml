<pu:WindowX x:Class="VPet.Plugin.LLMEP.ImageSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
        mc:Ignorable="d"
        Title="LLM表情包插件设置" 
        Width="800" Height="700"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="14">
    
    <Grid Background="#FAFAFA">
        <TabControl>
            <!-- 基本设置 Tab -->
            <TabItem Header="⚙️ 基本设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <!-- 功能开关 -->
                        <GroupBox Header="功能开关" Margin="0,0,0,20">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="CheckBoxEnabled" Content="启用插件" Margin="0,5" 
                                        Checked="CheckBoxEnabled_Changed" Unchecked="CheckBoxEnabled_Changed"/>
                                <CheckBox x:Name="CheckBoxBuiltInImages" Content="启用内置表情包" Margin="0,5"
                                        Checked="CheckBoxBuiltInImages_Changed" Unchecked="CheckBoxBuiltInImages_Changed"/>
                                <CheckBox x:Name="CheckBoxDIYImages" Content="启用DIY表情包" Margin="0,5"
                                        Checked="CheckBoxDIYImages_Changed" Unchecked="CheckBoxDIYImages_Changed"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 时间触发设置 -->
                        <GroupBox Header="⏰ 时间触发" Margin="0,0,0,20">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="CheckBoxTimeTrigger" Content="启用时间触发" Margin="0,5"
                                        Checked="CheckBoxTimeTrigger_Changed" Unchecked="CheckBoxTimeTrigger_Changed"/>
                                <StackPanel x:Name="TimeTriggerSettings" Margin="20,10,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="显示时长:" VerticalAlignment="Center" Width="80"/>
                                        <Slider x:Name="SliderDisplayDuration" Width="200" Minimum="1" Maximum="10" Value="3" TickFrequency="1" IsSnapToTickEnabled="True"
                                              ValueChanged="SliderDisplayDuration_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=SliderDisplayDuration, Path=Value, StringFormat={}{0:F0} 秒}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="显示间隔:" VerticalAlignment="Center" Width="80"/>
                                        <Slider x:Name="SliderDisplayInterval" Width="200" Minimum="1" Maximum="60" Value="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                              ValueChanged="SliderDisplayInterval_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=SliderDisplayInterval, Path=Value, StringFormat={}{0:F0} 分钟}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="CheckBoxRandomInterval" Content="随机间隔" Margin="0,5"
                                            Checked="CheckBoxRandomInterval_Changed" Unchecked="CheckBoxRandomInterval_Changed"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- 气泡触发设置 -->
                        <GroupBox Header="💬 气泡触发" Margin="0,0,0,20">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="CheckBoxBubbleTrigger" Content="启用气泡触发" Margin="0,5"
                                        Checked="CheckBoxBubbleTrigger_Changed" Unchecked="CheckBoxBubbleTrigger_Changed"/>
                                <StackPanel x:Name="BubbleTriggerSettings" Margin="20,10,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="触发概率:" VerticalAlignment="Center" Width="80"/>
                                        <Slider x:Name="SliderBubbleTriggerProbability" Width="200" Minimum="1" Maximum="100" Value="20" TickFrequency="1" IsSnapToTickEnabled="True"
                                              ValueChanged="SliderBubbleTriggerProbability_ValueChanged"/>
                                        <TextBlock Text="{Binding ElementName=SliderBubbleTriggerProbability, Path=Value, StringFormat={}{0:F0}%}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- 表情包目录 -->
                        <GroupBox Header="表情包目录" Margin="0,0,0,20">
                            <StackPanel Margin="10">
                                <TextBlock x:Name="TextBlockImagePath" Text="DIY_Expression/" FontFamily="Consolas" Background="#F5F5F5" Padding="5" Margin="0,5"/>
                                <Button x:Name="ButtonOpenFolder" Content="📁 打开表情包文件夹" Width="200" HorizontalAlignment="Left" Margin="0,5"
                                      Click="ButtonOpenFolder_Click"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- LLM设置 Tab -->
            <TabItem Header="🤖 LLM设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <!-- LLM功能开关 -->
                        <GroupBox Header="LLM情感分析" Margin="0,0,0,20">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="CheckBoxEmotionAnalysis" Content="启用LLM情感分析" Margin="0,5"
                                        Checked="CheckBoxEmotionAnalysis_Changed" Unchecked="CheckBoxEmotionAnalysis_Changed"/>
                                <CheckBox x:Name="CheckBoxAccurateImageMatching" Content="更加精确的使用表情包" Margin="0,5"
                                        Checked="CheckBoxAccurateImageMatching_Changed" Unchecked="CheckBoxAccurateImageMatching_Changed"/>
                                <CheckBox x:Name="CheckBoxVisionModel" Content="是可读取图片的模型(Vision)" Margin="0,5"
                                        Checked="CheckBoxVisionModel_Changed" Unchecked="CheckBoxVisionModel_Changed"/>
                                <TextBlock Text="ℹ️ 启用后可使用AI识别图片并生成标签功能" Foreground="#666666" FontSize="12" Margin="20,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- LLM提供商选择 -->
                        <GroupBox Header="LLM提供商" Margin="0,0,0,20">
                            <StackPanel Margin="10">
                                <ComboBox x:Name="ComboBoxLLMProvider" Margin="0,5" SelectionChanged="ComboBoxLLMProvider_SelectionChanged">
                                    <ComboBoxItem Content="OpenAI" Tag="openai"/>
                                    <ComboBoxItem Content="Google Gemini" Tag="gemini"/>
                                    <ComboBoxItem Content="Ollama (本地)" Tag="ollama"/>
                                    <ComboBoxItem Content="Free (免费)" Tag="free"/>
                                </ComboBox>
                            </StackPanel>
                        </GroupBox>

                        <!-- OpenAI配置 -->
                        <GroupBox x:Name="PanelOpenAI" Header="OpenAI 配置" Margin="0,0,0,20">
                            <StackPanel Margin="10">
                                <TextBlock Text="API Key:" Margin="0,5,0,2"/>
                                <TextBox x:Name="TextBoxOpenAIKey" Margin="0,0,0,10" TextChanged="TextBoxOpenAIKey_TextChanged"/>
                                <TextBlock Text="Base URL:" Margin="0,5,0,2"/>
                                <TextBox x:Name="TextBoxOpenAIBaseUrl" Text="https://api.openai.com/v1" Margin="0,0,0,10" TextChanged="TextBoxOpenAIBaseUrl_TextChanged"/>
                                <TextBlock Text="模型:" Margin="0,5,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="ComboBoxOpenAIModel" Width="200" IsEditable="True" Text="gpt-3.5-turbo"
                                            SelectionChanged="ComboBoxOpenAIModel_SelectionChanged" LostFocus="ComboBoxOpenAIModel_LostFocus"/>
                                    <Button x:Name="ButtonFetchOpenAIModels" Content="🔍 获取模型" Margin="10,0,0,0" Click="ButtonFetchOpenAIModels_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Gemini配置 -->
                        <GroupBox x:Name="PanelGemini" Header="Google Gemini 配置" Margin="0,0,0,20" Visibility="Collapsed">
                            <StackPanel Margin="10">
                                <TextBlock Text="API Key:" Margin="0,5,0,2"/>
                                <TextBox x:Name="TextBoxGeminiKey" Margin="0,0,0,10" TextChanged="TextBoxGeminiKey_TextChanged"/>
                                <TextBlock Text="Base URL:" Margin="0,5,0,2"/>
                                <TextBox x:Name="TextBoxGeminiBaseUrl" Text="https://generativelanguage.googleapis.com/v1beta" Margin="0,0,0,10" TextChanged="TextBoxGeminiBaseUrl_TextChanged"/>
                                <TextBlock Text="模型:" Margin="0,5,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="ComboBoxGeminiModel" Width="200" IsEditable="True" Text="gemini-pro"
                                            SelectionChanged="ComboBoxGeminiModel_SelectionChanged" LostFocus="ComboBoxGeminiModel_LostFocus"/>
                                    <Button x:Name="ButtonFetchGeminiModels" Content="🔍 获取模型" Margin="10,0,0,0" Click="ButtonFetchGeminiModels_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Ollama配置 -->
                        <GroupBox x:Name="PanelOllama" Header="Ollama 配置" Margin="0,0,0,20" Visibility="Collapsed">
                            <StackPanel Margin="10">
                                <TextBlock Text="Base URL:" Margin="0,5,0,2"/>
                                <TextBox x:Name="TextBoxOllamaBaseUrl" Text="http://localhost:11434" Margin="0,0,0,10" TextChanged="TextBoxOllamaBaseUrl_TextChanged"/>
                                <TextBlock Text="模型:" Margin="0,5,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="ComboBoxOllamaModel" Width="200" IsEditable="True" Text="llama2"
                                            SelectionChanged="ComboBoxOllamaModel_SelectionChanged" LostFocus="ComboBoxOllamaModel_LostFocus"/>
                                    <Button x:Name="ButtonFetchOllamaModels" Content="🔍 获取模型" Margin="10,0,0,0" Click="ButtonFetchOllamaModels_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Free配置 -->
                        <GroupBox x:Name="PanelFree" Header="Free 配置 (免费)" Margin="0,0,0,20" Visibility="Collapsed">
                            <StackPanel Margin="10">
                                <TextBlock x:Name="TextBlockFreeDescription"
                                         Text="ℹ️ Free服务使用VPetLLM的免费配置，无需额外设置API Key"
                                         Foreground="Blue" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TextBlockFreeProvider"
                                         Text="感谢提供者 QQ：790132463"
                                         Foreground="Green" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 网络代理配置 -->
                        <GroupBox Header="网络代理" Margin="0,0,0,20">
                            <StackPanel Margin="10">
                                <TextBlock Text="LLM 请求代理模式:" Margin="0,5,0,2"/>
                                <ComboBox x:Name="ComboBoxProxyMode" Margin="0,0,0,10" SelectionChanged="ComboBoxProxyMode_SelectionChanged">
                                    <ComboBoxItem Content="跟随系统代理" Tag="System"/>
                                    <ComboBoxItem Content="直连（不使用代理）" Tag="Direct"/>
                                    <ComboBoxItem Content="自定义代理" Tag="Custom"/>
                                </ComboBox>
                                <TextBlock x:Name="TextBlockProxyAddress" Text="代理地址 (如 http://127.0.0.1:7890 或 socks5://127.0.0.1:7891):" Margin="0,5,0,2" Visibility="Collapsed"/>
                                <TextBox x:Name="TextBoxProxyAddress" Margin="0,0,0,5" TextChanged="TextBoxProxyAddress_TextChanged" Visibility="Collapsed"/>
                                <TextBlock Text="ℹ️ 仅影响本插件的 LLM 情感分析/打标请求" Foreground="#666666" FontSize="12" Margin="0,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 在线网络表情包库 Tab -->
            <TabItem Header="🌐 在线表情包库">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <!-- 在线表情包功能开关 -->
                        <GroupBox Header="在线网络表情包库" Margin="0,0,0,20">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="CheckBoxOnlineSticker" Content="启用在线网络表情包库" Margin="0,5"
                                        Checked="CheckBoxOnlineSticker_Changed" Unchecked="CheckBoxOnlineSticker_Changed"/>
                                <TextBlock Text="ℹ️ 在线表情包库提供丰富的网络表情资源，可以根据情感分析结果自动匹配合适的表情包" 
                                         Foreground="Blue" Margin="0,5,0,0" TextWrapping="Wrap" FontSize="12"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 服务配置 -->
                        <GroupBox x:Name="GroupBoxOnlineStickerConfig" Header="服务配置" Margin="0,0,0,20">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="CheckBoxUseBuiltInCredentials" Content="使用 VPetLLM 表情包服务器" Margin="0,5"
                                        Checked="CheckBoxUseBuiltInCredentials_Changed" Unchecked="CheckBoxUseBuiltInCredentials_Changed"/>
                                <TextBlock Text="使用 VPetLLM 表情包服务" 
                                         Foreground="Green" Margin="0,5,0,10" TextWrapping="Wrap" FontSize="12"/>
                                
                                <!-- 自定义服务配置 -->
                                <StackPanel x:Name="PanelCustomService" Visibility="Collapsed">
                                    <TextBlock Text="服务地址:" Margin="0,5,0,2"/>
                                    <TextBox x:Name="TextBoxOnlineServiceUrl" Margin="0,0,0,10" TextChanged="TextBoxOnlineServiceUrl_TextChanged"/>
                                    <TextBlock Text="API Key:" Margin="0,5,0,2"/>
                                    <TextBox x:Name="TextBoxOnlineApiKey" Margin="0,0,0,10" TextChanged="TextBoxOnlineApiKey_TextChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- 显示设置 -->
                        <GroupBox x:Name="GroupBoxOnlineStickerDisplay" Header="显示设置" Margin="0,0,0,20">
                            <StackPanel Margin="10">
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="显示时长:" VerticalAlignment="Center" Width="80"/>
                                    <Slider x:Name="SliderOnlineDisplayDuration" Width="200" Minimum="1" Maximum="30" Value="6" TickFrequency="1" IsSnapToTickEnabled="True"
                                          ValueChanged="SliderOnlineDisplayDuration_ValueChanged"/>
                                    <TextBlock Text="{Binding ElementName=SliderOnlineDisplayDuration, Path=Value, StringFormat={}{0:F0} 秒}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="标签数量:" VerticalAlignment="Center" Width="80"/>
                                    <Slider x:Name="SliderOnlineTagCount" Width="200" Minimum="1" Maximum="50" Value="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                          ValueChanged="SliderOnlineTagCount_ValueChanged"/>
                                    <TextBlock Text="{Binding ElementName=SliderOnlineTagCount, Path=Value, StringFormat={}{0:F0} 个}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="缓存时长:" VerticalAlignment="Center" Width="80"/>
                                    <Slider x:Name="SliderOnlineCacheDuration" Width="200" Minimum="1" Maximum="60" Value="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                          ValueChanged="SliderOnlineCacheDuration_ValueChanged"/>
                                    <TextBlock Text="{Binding ElementName=SliderOnlineCacheDuration, Path=Value, StringFormat={}{0:F0} 分钟}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- 使用场景设置 -->
                        <GroupBox x:Name="GroupBoxOnlineStickerUsage" Header="使用场景" Margin="0,0,0,20">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="CheckBoxOnlinePreferOnline" Content="优先使用在线表情包" Margin="0,5"
                                        Checked="CheckBoxOnlinePreferOnline_Changed" Unchecked="CheckBoxOnlinePreferOnline_Changed"/>
                                <TextBlock Text="勾选后将优先使用在线表情包，否则作为本地表情包的补充" 
                                         Foreground="#666666" Margin="20,0,0,10" TextWrapping="Wrap" FontSize="12"/>
                                
                                <CheckBox x:Name="CheckBoxOnlineInEmotion" Content="在情感分析中使用" Margin="0,5"
                                        Checked="CheckBoxOnlineInEmotion_Changed" Unchecked="CheckBoxOnlineInEmotion_Changed"/>
                                <CheckBox x:Name="CheckBoxOnlineInRandom" Content="在随机显示中使用" Margin="0,5"
                                        Checked="CheckBoxOnlineInRandom_Changed" Unchecked="CheckBoxOnlineInRandom_Changed"/>
                                <CheckBox x:Name="CheckBoxOnlineInBubble" Content="在气泡触发中使用" Margin="0,5"
                                        Checked="CheckBoxOnlineInBubble_Changed" Unchecked="CheckBoxOnlineInBubble_Changed"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 连接测试 -->
                        <GroupBox x:Name="GroupBoxOnlineStickerTest" Header="连接测试" Margin="0,0,0,20">
                            <StackPanel Margin="10">
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <Button x:Name="ButtonTestOnlineConnection" Content="🔗 测试连接" Width="120" Margin="0,0,10,0" Click="ButtonTestOnlineConnection_Click"/>
                                    <Button x:Name="ButtonTestOnlineSticker" Content="🎭 测试表情包" Width="120" Click="ButtonTestOnlineSticker_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="TextBlockOnlineStatus" Text="准备就绪" Margin="0,10,0,0" FontSize="12" Foreground="#666666"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 标签管理 Tab -->
            <TabItem Header="🏷️ 标签管理">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- AI标签生成设置 -->
                    <GroupBox Grid.Row="0" Header="🤖 AI标签生成" Margin="0,0,0,15">
                        <StackPanel Margin="10">
                            <CheckBox x:Name="CheckBoxAIImageTagging" Content="允许AI识别图片并生成标签" Margin="0,5"
                                    Checked="CheckBoxAIImageTagging_Changed" Unchecked="CheckBoxAIImageTagging_Changed"/>
                            <TextBlock Text="ℹ️ 需要先在LLM设置中启用&quot;是可读取图片的模型&quot;，并配置支持Vision的LLM模型（如Gemini 2.5 flash等）" 
                                     Foreground="#666666" FontSize="12" Margin="20,5,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TextBlockAIProcessingStatus" Text="状态: 等待开始" Margin="20,10,0,0" FontSize="12" Foreground="#0066CC"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 顶部操作栏 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                        <Button x:Name="ButtonScanImages" Content="🔍 扫描图片" Width="120" Margin="0,0,10,0" Click="ButtonScanImages_Click"/>
                        <Button x:Name="ButtonSaveLabels" Content="💾 保存标签" Width="120" Click="ButtonSaveLabels_Click"/>
                        <Button x:Name="ButtonStartAIProcessing" Content="🤖 开始AI处理" Width="120" Margin="10,0,0,0" Click="ButtonStartAIProcessing_Click"/>
                    </StackPanel>

                    <!-- 主要内容区域 -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：图片树形列表 -->
                        <GroupBox Grid.Column="0" Header="📁 图片目录" Margin="0,0,10,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TreeView x:Name="TreeViewImages" Background="Transparent" BorderThickness="0" SelectedItemChanged="TreeViewImages_SelectedItemChanged"/>
                            </ScrollViewer>
                        </GroupBox>

                        <!-- 右侧：图片预览和标签编辑 -->
                        <GroupBox Grid.Column="1" Header="🖼️ 图片详情" Margin="10,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <!-- 空状态显示 -->
                                    <StackPanel x:Name="PanelEmptyState" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              Visibility="Visible">
                                        <TextBlock Text="📷" FontSize="48" HorizontalAlignment="Center" Foreground="#CCCCCC" Margin="0,0,0,16"/>
                                        <TextBlock Text="选择图片开始编辑标签" FontSize="16" HorizontalAlignment="Center" Foreground="#999999"/>
                                    </StackPanel>

                                    <!-- 图片详情面板 -->
                                    <StackPanel x:Name="PanelImageDetails" Visibility="Collapsed">
                                        <TextBlock x:Name="TextBlockImageTitle" Text="🖼️ 选择图片查看预览" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                        
                                        <!-- 图片预览 -->
                                        <Border Background="#F8F8F8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="8" Margin="0,0,0,10" MaxHeight="200">
                                            <Image x:Name="ImagePreview" Stretch="Uniform" StretchDirection="DownOnly"/>
                                        </Border>

                                        <!-- 图片信息 -->
                                        <TextBlock x:Name="TextBlockFileName" Text="文件名: " FontSize="12" Foreground="#666666" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TextBlockFileSize" Text="大小: " FontSize="12" Foreground="#666666" Margin="0,0,0,10"/>
                                        
                                        <!-- 标签编辑区域 -->
                                        <TextBlock Text="🏷️ 图片标签" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <TextBlock Text="用逗号分隔多个标签，如：开心,笑脸,高兴" FontSize="12" Foreground="#999999" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TextBoxImageTags" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextChanged="TextBoxImageTags_TextChanged" Margin="0,0,0,10"/>
                                        
                                        <!-- 心情选择 -->
                                        <TextBlock Text="💭 心情分类" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <TextBlock Text="选择此图片对应的心情，未选择时作为泛用表情包" FontSize="12" Foreground="#999999" Margin="0,0,0,5"/>
                                        <ComboBox x:Name="ComboBoxEmotion" SelectionChanged="ComboBoxEmotion_SelectionChanged">
                                            <ComboBoxItem Content="泛用 (General)" Tag="general"/>
                                            <ComboBoxItem Content="开心 (Happy)" Tag="happy"/>
                                            <ComboBoxItem Content="正常 (Normal)" Tag="normal"/>
                                            <ComboBoxItem Content="状态不佳 (Poor)" Tag="poor"/>
                                            <ComboBoxItem Content="生病 (Ill)" Tag="ill"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </GroupBox>
                    </Grid>

                    <!-- 底部状态栏 -->
                    <Border Grid.Row="3" Background="#F8F8F8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,20,0,0">
                        <TextBlock x:Name="TextBlockStatus" Text="准备就绪" FontSize="12" Foreground="#666666"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 调试 Tab -->
            <TabItem Header="🔧 调试">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 调试设置 -->
                    <GroupBox Grid.Row="0" Header="调试设置" Margin="0,0,0,20">
                        <StackPanel Margin="10">
                            <CheckBox x:Name="CheckBoxDebugMode" Content="调试模式" Margin="0,5" Checked="CheckBoxDebugMode_Changed" Unchecked="CheckBoxDebugMode_Changed"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="日志等级:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="ComboBoxLogLevel" Width="120" SelectionChanged="ComboBoxLogLevel_SelectionChanged">
                                    <ComboBoxItem Content="Debug" Tag="0"/>
                                    <ComboBoxItem Content="Info" Tag="1"/>
                                    <ComboBoxItem Content="Warning" Tag="2"/>
                                    <ComboBoxItem Content="Error" Tag="3"/>
                                </ComboBox>
                                <CheckBox x:Name="CheckBoxFileLogging" Content="文件日志" Margin="20,0,0,0" Checked="SwitchFileLogging_Changed" Unchecked="SwitchFileLogging_Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- 日志显示区域 -->
                    <GroupBox Grid.Row="2" Header="📋 调试日志">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <Button Grid.Row="0" x:Name="ButtonClearLog" Content="🗑️ 清空日志" Width="100" HorizontalAlignment="Right" Margin="0,0,0,10" Click="ButtonClearLog_Click"/>
                            
                            <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBox x:Name="TextBoxLog" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="11" Text="日志将显示在这里..."/>
                            </ScrollViewer>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
        
        <!-- 底部按钮栏 -->
        <Grid VerticalAlignment="Bottom" Background="White" Height="60">
            <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20">
                <Button x:Name="ButtonTestDisplay" Content="🎭 测试显示" Width="100" Margin="0,0,10,0" Click="ButtonTestDisplay_Click"/>
                <Button x:Name="ButtonSave" Content="💾 保存" Width="80" Margin="0,0,10,0" Click="ButtonSave_Click"/>
                <Button x:Name="ButtonReset" Content="🔄 重置" Width="80" Margin="0,0,10,0" Click="ButtonReset_Click"/>
                <Button x:Name="ButtonCancel" Content="❌ 取消" Width="80" Click="ButtonCancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</pu:WindowX>